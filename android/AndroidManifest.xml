<?xml version="1.0" encoding="utf-8"?>
<!-- Qubit Quest for Android: the web game in a full-screen WebView, from the app's own files.
     No permissions at all: it never goes online. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.junkers4.qubitquest">

    <application
        android:label="Qubit Quest"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/Game">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
